<?xml version="1.0" encoding="UTF-8"?>
<!--
  Retro 60s dial artwork TEMPLATE: the STATIC layer only (bezel, cream face, graduations,
  numerals, labels, glass glint). The needle, peak flag, hub, "NO LINK" and the optional
  badge are drawn live by RetroLook.

  The graduations, numerals and red band are generated from spec.json, the single source
  of truth for the scale geometry (the C++ reads the same numbers), so edit those values
  there, not here.

  Build:  python tools/make_look.py retro
-->
<svg xmlns="http://www.w3.org/2000/svg" width="240" height="240" viewBox="0 0 240 240">
  <defs>
    <linearGradient id="chrome1" x1="0.1" y1="0" x2="0.9" y2="1">
      <stop offset="0" stop-color="#fbfcfd"/>
      <stop offset="0.22" stop-color="#aab1ba"/>
      <stop offset="0.48" stop-color="#5a6068"/>
      <stop offset="0.72" stop-color="#cfd4da"/>
      <stop offset="1" stop-color="#7d838b"/>
    </linearGradient>
    <linearGradient id="chrome2" x1="0.9" y1="1" x2="0.1" y2="0">
      <stop offset="0" stop-color="#e9ecef"/>
      <stop offset="0.5" stop-color="#4b5058"/>
      <stop offset="1" stop-color="#bfc5cb"/>
    </linearGradient>
    <radialGradient id="cream" cx="0.42" cy="0.36" r="0.8">
      <stop offset="0" stop-color="#f6eedb"/>
      <stop offset="0.7" stop-color="#ebe0c5"/>
      <stop offset="1" stop-color="#d9ccac"/>
    </radialGradient>
    <radialGradient id="age" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0.8" stop-color="#5a4a2a" stop-opacity="0"/>
      <stop offset="1" stop-color="#5a4a2a" stop-opacity="0.28"/>
    </radialGradient>
    <linearGradient id="glass" x1="0.2" y1="0" x2="0.6" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.34"/>
      <stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
  </defs>

  <circle cx="120" cy="120" r="119.5" fill="#050506"/>
  <circle cx="120" cy="120" r="113.5" fill="none" stroke="url(#chrome1)" stroke-width="12"/>
  <circle cx="120" cy="120" r="107.4" fill="none" stroke="url(#chrome2)" stroke-width="1.6"/>
  <circle cx="120" cy="120" r="106.5" fill="url(#cream)"/>
  <circle cx="120" cy="120" r="106.5" fill="url(#age)"/>

  <!-- red band: from redFromPsi to maxPsi -->
  <path d="@RED_BAND@" fill="none" stroke="#c0261c" stroke-width="4.6"/>

  <!-- graduations: major every 5 psi, minor every 1 psi -->
  <path d="@MAJOR_TICKS@" fill="none" stroke="#1c1a16" stroke-width="2.2"/>
  <path d="@MINOR_TICKS@" fill="none" stroke="#1c1a16" stroke-width="0.9"/>

  <g font-family="Jost" font-size="18" font-weight="500" text-anchor="middle" dominant-baseline="central" fill="#1c1a16">
    @NUMERALS@
  </g>

  <text x="120" y="108" font-family="Jost" font-size="12" font-weight="500" letter-spacing="4.5" text-anchor="middle" fill="#1c1a16">BOOST</text>
  <text x="120" y="158" font-family="Jost" font-size="7.6" font-weight="500" letter-spacing="2.2" text-anchor="middle" fill="#1c1a16">LBS / SQ IN</text>

  <!-- glass glint (baked in: the needle is drawn over it) -->
  <path d="M28 84A98 98 0 0 1 130 21A132 132 0 0 0 28 84Z" fill="url(#glass)"/>
</svg>
